# ─── Servidor ────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Base de Datos ────────────────────────────────────────
# Sequelize CLI usa DATABASE_URL si está definida.
# Si no, se construye automáticamente desde las variables DB_*
DATABASE_URL=postgres://user:password@localhost:5432/inventario_db

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME_secure_password
DB_NAME=inventario_db
DB_DIALECT=postgres
DB_SSL=false
# Solo poner en false si el servidor usa un certificado autofirmado.
# false acepta cualquier certificado y expone la conexión a MITM.
DB_SSL_REJECT_UNAUTHORIZED=true

# ─── Seguridad ────────────────────────────────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_min_32_chars_random_string
JWT_EXPIRES_IN=24h
SESSION_SECRET=CHANGE_ME_min_32_chars_random_string

# ─── CORS ─────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ─── Rate Limiting ────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
# Nº de proxies de confianza delante de la app (LB, ingress, CDN).
# 0 = sin proxy. Si es 0 detrás de un balanceador, el rate limit ve la IP
# del proxy y todos los clientes comparten la misma cuota.
TRUST_PROXY=0

# ─── Logging ─────────────────────────────────────────────
LOG_LEVEL=info
